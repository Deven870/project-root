# ============================================================
# VoiceBot System Configuration (.env Template)
# ============================================================
# Copy as .env and fill in your values
#
# IMPORTANT: Never commit .env to version control!
# Update .gitignore to include: .env, credentials.json
#

# ===== ENVIRONMENT & DEBUG =====
ENVIRONMENT=development
DEBUG_MODE=false
LOG_LEVEL=INFO
LOGS_DIRECTORY=logs

# ===== API SERVER =====
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4
DASHBOARD_PORT=8501

# ===== DATABASE CONFIGURATION =====
# Options: sqlite, postgresql
DB_TYPE=sqlite
DB_PATH=data/voicebot.db

# For PostgreSQL:
# DB_TYPE=postgresql
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=voicebot

SQL_ECHO=false

# ===== STOCK MARKET SETTINGS =====
STOCK_SYMBOL=RELIANCE.NS
DEFAULT_LOOKBACK_DAYS=365
TIMEZONE=Asia/Kolkata

# ===== API KEYS =====
FINNHUB_API_KEY=your_finnhub_api_key
NEWS_API_KEY=your_news_api_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# ===== GOOGLE SHEETS INTEGRATION =====
GOOGLE_SHEETS_ID=your_sheet_id
GOOGLE_CREDENTIALS_PATH=credentials.json
SERVICE_ACCOUNT_FILE=service_account.json
SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID

# ===== TELEGRAM BOT ALERTS =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
ENABLE_TELEGRAM_NOTIFICATIONS=true

# ===== EMAIL ALERTS =====
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
ENABLE_EMAIL_ALERTS=false

# ===== TRADING SETTINGS =====
ENABLE_LIVE_TRADING=false
ENABLE_BACKTESTING=true
ENABLE_SENTIMENT_ANALYSIS=true
USE_SYNTHETIC_DATA=false
DEFAULT_RISK_PERCENTAGE=2.0
MAX_DAILY_TRADES=10

# ===== JWT & SECURITY =====
# IMPORTANT: Change this in production!
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_LENGTH=32
ENABLE_CORS=true
CORS_ORIGINS=*

# ===== FEATURE FLAGS =====
ENABLE_SCHEDULER=true
ENABLE_API=true
ENABLE_DASHBOARD=true
ENABLE_DATABASE_LOGGING=false

# ===== PAYMENT INTEGRATION (Razorpay) =====
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
ENABLE_PAYMENTS=false

# ===== BROKER INTEGRATION =====
# Options: zerodha, shoonya, none
BROKER_TYPE=none
ZERODHA_API_KEY=
ZERODHA_SECRET=
ZERODHA_USER_ID=

# ===== MARKET HOURS =====
MARKET_START_TIME=09:15
MARKET_END_TIME=15:30
MARKET_DAYS=1,2,3,4,5

# ===== ADVANCED OPTIONS =====
# Uncomment to enable specific features
# ENABLE_ADVANCED_BACKTESTING=true
# ENABLE_MONTE_CARLO_SIMULATION=true
# ENABLE_PORTFOLIO_OPTIMIZATION=true
