# ============================================================================
# PRODUCTION CONFIGURATION - Copy to .env and fill in your values
# ============================================================================
# DO NOT COMMIT this file to git - it will contain sensitive credentials

# ===== 📊 STOCK MARKET =====
STOCK_SYMBOL=RELIANCE.NS
NEWS_API_KEY=your_newsapi_key_here
# Get free key from: https://newsapi.org/

# ===== 🔐 GOOGLE SHEETS INTEGRATION =====
# Instructions: See SHEETS_SETUP.md or TRACKING_QUICK_START.md
# 1. Create Google Cloud project
# 2. Enable Sheets & Drive APIs
# 3. Create service account with JSON key
# 4. Save JSON as google_credentials.json in project root
# 5. Share your Google Sheet with the service account email
SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit#gid=0
GOOGLE_CREDENTIALS_PATH=./google_credentials.json

# ===== 🏦 BROKER INTEGRATION (Optional - Future Feature) =====
# For live trading via Zerodha or other brokers
# ZERODHA_API_KEY=your_zerodha_api_key
# ZERODHA_SECRET=your_zerodha_secret
# BROKER_TYPE=zerodha  # or other broker names

# ===== 🔍 LOGGING & MONITORING =====
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/digitrader.log
# Set to empty string "" to disable file logging

# ===== 🚀 DEPLOYMENT =====
STREAMLIT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_SHOWERRORDETAILS=false
STREAMLIT_SERVER_HEADLESS=true
# For production, set STREAMLIT_CLIENT_SHOWERRORDETAILS=false
# This hides detailed error messages from users

# ===== 📈 DATA & FEATURES =====
DEFAULT_LOOKBACK_DAYS=365
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_BACKTESTING=true
ENABLE_LIVE_TRADING=false
# Set ENABLE_LIVE_TRADING=true only when broker integration is complete

# ===== 🔧 DEBUG (Set to false in production) =====
DEBUG_MODE=false
USE_SYNTHETIC_DATA=false
# When USE_SYNTHETIC_DATA=true and real data fetch fails, use fallback data
# Set to false for strict production mode
