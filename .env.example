# Stock Symbol Configuration
STOCK_SYMBOL=RELIANCE.NS

# Finnhub API Configuration
# Get your free API key from https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Google Sheets Configuration - Legacy (old google_sheets.py module)
# Follow setup guide in GOOGLE_SHEETS_SETUP.md
SHEETS_ID=your_google_sheets_id_here
SERVICE_ACCOUNT_FILE=service_account.json

# Google Sheets Live Trading Integration (sheets_live.py module)
# 1. Create a Google Cloud project and enable Sheets API
# 2. Create a service account and download credentials.json
# 3. Share the spreadsheet with the service account email
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json

# Telegram Alerts (Optional - for trade notifications)
# 1. Create bot via @BotFather on Telegram
# 2. Get bot token and your chat ID
# 3. Search for the bot and message "/start"
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Gmail Alerts (Optional - for email notifications)
# 1. Enable 2FA on Gmail
# 2. Generate app-specific password: https://myaccount.google.com/apppasswords
# 3. Use that app password below (not your regular Gmail password)
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
