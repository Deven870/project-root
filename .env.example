# ============================================================================
# PRODUCTION CONFIGURATION - Copy to .env and fill in your values
# ============================================================================
# DO NOT COMMIT this file to git - it will contain sensitive credentials

# ===== 📊 STOCK MARKET =====
STOCK_SYMBOL=RELIANCE.NS
WATCHLIST=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ITC.NS,WIPRO.NS,BAJFINANCE.NS,MARUTI.NS,SBIN.NS,TATAMOTORS.NS
STARTING_CAPITAL=100000
MAX_RISK_PCT=0.02
MIN_CONFIDENCE=0.65
VIX_THRESHOLD=20
MIN_POSITIVE_SENTIMENT=0.20

# ===== 📡 NEWS APIs =====
NEWS_API_KEY=your_newsapi_key_here
# Get free key from: https://newsapi.org/

# ===== 🔐 FINNHUB DATA API =====
# Get your free API key from https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# ===== 🏦 ANGEL ONE SmartAPI (Live Prices - FIX 10) =====
# Get API credentials at: https://smartapi.angelbroking.com
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_MPIN=your_mpin
ANGEL_TOTP_KEY=your_totp_secret_key

# ===== 📱 TELEGRAM ALERTS (FIX 6 - Optional for notifications) =====
# 1. Create bot via @BotFather on Telegram
# 2. Get bot token and your chat ID
# 3. Search for the bot and message "/start"
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===== 📊 EXCEL TRACKING (FIX 11 - Auto-logging) =====
# Path to your Excel workbook for paper trading log
EXCEL_TRACKER_PATH=Digitrader_PaperTrading.xlsx

# ===== 🔐 GOOGLE SHEETS INTEGRATION =====
# Instructions: See SHEETS_SETUP.md or TRACKING_QUICK_START.md
# 1. Create Google Cloud project and enable Sheets API
# 2. Create a service account and download credentials.json
# 3. Share your Google Sheet with the service account email
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json
SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit#gid=0

# ===== 📧 GMAIL ALERTS (Optional - for email notifications) =====
# 1. Enable 2FA on Gmail
# 2. Generate app-specific password: https://myaccount.google.com/apppasswords
# 3. Use that app password below (not your regular Gmail password)
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ===== 🏦 BROKER INTEGRATION (Optional - Future Feature) =====
# For live trading via Zerodha or other brokers
# ZERODHA_API_KEY=your_zerodha_api_key
# ZERODHA_SECRET=your_zerodha_secret
# BROKER_TYPE=zerodha  # or other broker names

# ===== 🔍 LOGGING & MONITORING =====
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/digitrader.log

# ===== 🚀 DEPLOYMENT =====
STREAMLIT_LOGGER_LEVEL=info
DEBUG_MODE=false
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_BACKTESTING=true
ENABLE_LIVE_TRADING=false
USE_SYNTHETIC_DATA=false

# ===== DEFAULT VALUES (can be overridden per session) =====
DEFAULT_LOOKBACK_DAYS=365
STREAMLIT_CLIENT_SHOWERRORDETAILS=false
STREAMLIT_SERVER_HEADLESS=true

# ===== 📈 DATA & FEATURES =====
DEFAULT_LOOKBACK_DAYS=365
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_BACKTESTING=true
ENABLE_LIVE_TRADING=false

# ===== 🔧 DEBUG (Set to false in production) =====
DEBUG_MODE=false
USE_SYNTHETIC_DATA=false
